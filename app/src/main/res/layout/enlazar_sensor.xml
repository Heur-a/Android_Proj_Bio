        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent" />-->

    <TextView
        android:id="@+id/texto2"
        android:layout_width="20dp"
        android:layout_height="40dp"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/montserratmedium"
        android:text="o"
        android:textAlignment="center"
        android:textColor="@color/verdeOscuro"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.503"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/enlazarSensor" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="O"
        android:textColor="@color/verdeOscuro"
        android:textColorLink="#000000"
        android:textSize="34sp"
        app:layout_constraintBottom_toTopOf="@+id/contraseñaLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <Button
        android:id="@+id/enlazarSensor"
        android:layout_width="136dp"
        android:layout_height="133dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/verdeBoton"
        android:text="[   ]"
        android:textColor="@color/verdeBotonColor"
        android:textSize="60sp"
        app:circularflow_angles="TRUE"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/texto" />

</androidx.constraintlayout.widget.ConstraintLayout>